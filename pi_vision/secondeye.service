# ============================================================================
# secondeye.service
# 라즈베리파이 부팅 시 자동으로 taillight_detection_test.py를 실행시키는 systemd 서비스 파일
#
# 설치 방법 (Pi 터미널에서):
#   1) sudo cp secondeye.service /etc/systemd/system/secondeye.service
#   2) sudo systemctl daemon-reload
#   3) sudo systemctl enable secondeye.service     ← 부팅 시 자동시작 등록
#   4) sudo systemctl start secondeye.service      ← 지금 바로 시작(재부팅 안 해도 테스트 가능)
#
# 확인 방법:
#   sudo systemctl status secondeye.service        ← 지금 돌고 있는지 상태 확인
#   tail -f ~/secondeye.log                         ← 실시간 로그 보기 (Ctrl+C로 종료)
#
# 끄는 방법 (디버깅하려고 수동으로 다시 돌리고 싶을 때):
#   sudo systemctl stop secondeye.service           ← 지금 멈춤
#   sudo systemctl disable secondeye.service         ← 다음 부팅부터는 자동시작 안 함
# ============================================================================

[Unit]
Description=SecondEye - YOLO taillight detection + STM32 link
# 파일시스템/네트워크 등 기본 부팅 절차가 끝난 뒤에 시작 (카메라/시리얼 장치도 그때쯤 다 잡혀있음)
After=multi-user.target

[Service]
Type=simple
User=jun
WorkingDirectory=/home/jun
# ★중요: PYTHONUNBUFFERED=1 없으면 print()가 파일로 바로 안 써지고 한참 버퍼에 쌓였다가 몰아서 써짐
#        (터미널에 직접 붙어있을 땐 자동으로 줄단위로 바로바로 써지는데, systemd로 돌리면 그게 아니라서 생기는 문제)
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/jun/yolo_env/bin/python3 -u /home/jun/taillight_detection_test.py
# 스크립트가 무슨 이유로든 죽으면(카메라 인식 지연 등) 5초 후 자동 재시작
Restart=on-failure
RestartSec=5
# 화면 없이 돌아가므로, print()로 찍히는 로그를 파일로 저장해서 나중에 확인 가능하게 함
StandardOutput=append:/home/jun/secondeye.log
StandardError=append:/home/jun/secondeye.log

[Install]
WantedBy=multi-user.target
