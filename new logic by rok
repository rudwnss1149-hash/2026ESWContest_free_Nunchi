"""
BrakeCoach - 실차 테스트용

기존 구조 유지:
- YOLO로 차량 검출
- 가장 가까운 차량을 추적
- 차량 후면의 빨간 영역 검출
- 브레이크등 밝기 변화 감지
- STM32에서 레이더 거리/상대속도 수신
- STM32로 밝기 델타 전송

추가된 안정화:
1. 차량 위치/크기 급변 필터
2. 차량 박스 EMA 필터
3. 레이더 거리 중앙값 + EMA
4. 레이더 상대속도 중앙값 + EMA
5. 브레이크등 연속 프레임 판정
6. 레이더 + 카메라 융합 WARNING
"""

import cv2
import numpy as np
import time
from collections import deque
from ultralytics import YOLO
import serial
import threading


# ============================================================
# 기본 설정
# ============================================================

SMOOTHING_FRAMES = 5

DELTA_THRESHOLD = 15.0

MIN_RED_PIXELS = 15

PADDING = 5

MIN_CAR_AREA_RATIO = 0.02

HIGHMOUNT_TOP = 0.00
HIGHMOUNT_BOTTOM = 0.15

TAILLIGHT_TOP = 0.35
TAILLIGHT_BOTTOM = 0.55

SAVE_EVERY_N_FRAMES = 5

BASELINE_AT_FRAME = 30

YOLO_INTERVAL = 8

YOLO_IMGSZ = 320


# ============================================================
# 차량 추적 필터
# ============================================================

CAR_EMA_ALPHA = 0.35

MAX_CENTER_JUMP_RATIO = 0.25

MAX_SIZE_CHANGE_RATIO = 0.45

MAX_MISSED_FRAMES = 24


# ============================================================
# 레이더 필터
# ============================================================

RADAR_FILTER_SIZE = 3

RADAR_EMA_ALPHA = 0.35

MAX_DISTANCE_JUMP = 8.0

MAX_SPEED_JUMP = 20.0


# ============================================================
# WARNING 조건
# ============================================================

WARNING_DISTANCE = 30.0

WARNING_APPROACH_SPEED = 3.0

WARNING_BRAKE_MISSING_FRAMES = 5


# ============================================================
# STM32 통신
# ============================================================

STM32_PORT = "/dev/serial0"

STM32_BAUD = 115200


# ============================================================
# 레이더 최신값
# ============================================================

latest_radar_distance = None

latest_radar_speed = None

serial_data_lock = threading.Lock()


# ============================================================
# 레이더 필터용 변수
# ============================================================

radar_distance_history = deque(
    maxlen=RADAR_FILTER_SIZE
)

radar_speed_history = deque(
    maxlen=RADAR_FILTER_SIZE
)

filtered_radar_distance = None

filtered_radar_speed = None


# ============================================================
# 차량 추적용 변수
# ============================================================

filtered_car_box = None

missed_car_frames = 0


# ============================================================
# 모델
# ============================================================

print(
    "[YOLO] 모델 로딩 중..."
)

model = YOLO(
    "yolov8n.pt"
)

print(
    "[YOLO] 모델 로딩 완료"
)


# ============================================================
# STM32 레이더 수신
# ============================================================

def stm32_serial_reader(ser):

    global latest_radar_distance
    global latest_radar_speed

    while True:

        try:

            raw_line = ser.readline()

            if not raw_line:
                continue

            line = raw_line.decode(
                "utf-8",
                errors="ignore"
            ).strip()

            if not line.startswith("R,"):
                continue

            parts = line.split(",")

            if len(parts) != 3:
                continue

            try:

                dist = float(
                    parts[1]
                )

                spd = float(
                    parts[2]
                )

                with serial_data_lock:

                    latest_radar_distance = dist

                    latest_radar_speed = spd

            except ValueError:

                pass

        except Exception as e:

            print(
                f"[STM32] 시리얼 읽기 에러: {e}"
            )

            time.sleep(1)


# ============================================================
# 레이더 필터
# ============================================================

def update_radar_filter(
    raw_distance,
    raw_speed
):

    global filtered_radar_distance
    global filtered_radar_speed

    if raw_distance is None:
        return None, None

    # --------------------------------------------------------
    # 거리 이상치 제거
    # --------------------------------------------------------

    if filtered_radar_distance is not None:

        if abs(
            raw_distance
            -
            filtered_radar_distance
        ) > MAX_DISTANCE_JUMP:

            return (
                filtered_radar_distance,
                filtered_radar_speed
            )

    # --------------------------------------------------------
    # 거리 중앙값
    # --------------------------------------------------------

    radar_distance_history.append(
        raw_distance
    )

    distance_median = float(
        np.median(
            radar_distance_history
        )
    )

    # --------------------------------------------------------
    # 거리 EMA
    # --------------------------------------------------------

    if filtered_radar_distance is None:

        filtered_radar_distance = (
            distance_median
        )

    else:

        filtered_radar_distance = (
            RADAR_EMA_ALPHA
            *
            distance_median
            +
            (1.0 - RADAR_EMA_ALPHA)
            *
            filtered_radar_distance
        )

    # --------------------------------------------------------
    # 속도
    # --------------------------------------------------------

    if raw_speed is not None:

        if filtered_radar_speed is not None:

            if abs(
                raw_speed
                -
                filtered_radar_speed
            ) <= MAX_SPEED_JUMP:

                radar_speed_history.append(
                    raw_speed
                )

        else:

            radar_speed_history.append(
                raw_speed
            )

        if len(
            radar_speed_history
        ) > 0:

            speed_median = float(
                np.median(
                    radar_speed_history
                )
            )

            if filtered_radar_speed is None:

                filtered_radar_speed = (
                    speed_median
                )

            else:

                filtered_radar_speed = (
                    RADAR_EMA_ALPHA
                    *
                    speed_median
                    +
                    (1.0 - RADAR_EMA_ALPHA)
                    *
                    filtered_radar_speed
                )

    return (
        filtered_radar_distance,
        filtered_radar_speed
    )


# ============================================================
# 빨간 Blob 검출
# ============================================================

def find_red_blobs(
    frame,
    region,
    max_blobs
):

    x1, y1, x2, y2 = region

    x1 = max(
        0,
        int(x1)
    )

    y1 = max(
        0,
        int(y1)
    )

    x2 = min(
        frame.shape[1],
        int(x2)
    )

    y2 = min(
        frame.shape[0],
        int(y2)
    )

    crop = frame[
        y1:y2,
        x1:x2
    ]

    if crop.size == 0:

        return []

    hsv = cv2.cvtColor(
        crop,
        cv2.COLOR_BGR2HSV
    )

    lower_red1 = np.array(
        [0, 100, 100]
    )

    upper_red1 = np.array(
        [10, 255, 255]
    )

    lower_red2 = np.array(
        [160, 100, 100]
    )

    upper_red2 = np.array(
        [180, 255, 255]
    )

    mask1 = cv2.inRange(
        hsv,
        lower_red1,
        upper_red1
    )

    mask2 = cv2.inRange(
        hsv,
        lower_red2,
        upper_red2
    )

    red_mask = cv2.bitwise_or(
        mask1,
        mask2
    )

    kernel = np.ones(
        (3, 3),
        np.uint8
    )

    red_mask = cv2.morphologyEx(
        red_mask,
        cv2.MORPH_OPEN,
        kernel
    )

    num_labels, labels, stats, _ = (
        cv2.connectedComponentsWithStats(
            red_mask,
            connectivity=8
        )
    )

    blob_areas = stats[
        1:,
        cv2.CC_STAT_AREA
    ]

    if len(blob_areas) == 0:

        return []

    top_indices = np.argsort(
        blob_areas
    )[::-1][:max_blobs]

    results = []

    for idx in top_indices:

        label_id = idx + 1

        area = stats[
            label_id,
            cv2.CC_STAT_AREA
        ]

        if area < MIN_RED_PIXELS:

            continue

        bx = stats[
            label_id,
            cv2.CC_STAT_LEFT
        ]

        by = stats[
            label_id,
            cv2.CC_STAT_TOP
        ]

        bw = stats[
            label_id,
            cv2.CC_STAT_WIDTH
        ]

        bh = stats[
            label_id,
            cv2.CC_STAT_HEIGHT
        ]

        final_x1 = (
            x1
            +
            max(
                0,
                bx - PADDING
            )
        )

        final_y1 = (
            y1
            +
            max(
                0,
                by - PADDING
            )
        )

        final_x2 = (
            x1
            +
            min(
                crop.shape[1],
                bx + bw + PADDING
            )
        )

        final_y2 = (
            y1
            +
            min(
                crop.shape[0],
                by + bh + PADDING
            )
        )

        results.append(
            (
                int(final_x1),
                int(final_y1),
                int(final_x2),
                int(final_y2)
            )
        )

    return results


# ============================================================
# 차량 검색 영역
# ============================================================

def get_search_regions(
    car_box
):

    x1, y1, x2, y2 = car_box

    box_height = y2 - y1

    highmount_region = (
        x1,
        y1
        +
        box_height
        *
        HIGHMOUNT_TOP,
        x2,
        y1
        +
        box_height
        *
        HIGHMOUNT_BOTTOM
    )

    taillight_region = (
        x1,
        y1
        +
        box_height
        *
        TAILLIGHT_TOP,
        x2,
        y1
        +
        box_height
        *
        TAILLIGHT_BOTTOM
    )

    return (
        highmount_region,
        taillight_region
    )


# ============================================================
# 빨간 영역 밝기
# ============================================================

def get_red_brightness(
    frame,
    roi
):

    x1, y1, x2, y2 = roi

    x1 = max(
        0,
        int(x1)
    )

    y1 = max(
        0,
        int(y1)
    )

    x2 = min(
        frame.shape[1],
        int(x2)
    )

    y2 = min(
        frame.shape[0],
        int(y2)
    )

    crop = frame[
        y1:y2,
        x1:x2
    ]

    if crop.size == 0:

        return None

    b, g, r = cv2.split(
        crop
    )

    return float(
        np.mean(r)
    )


# ============================================================
# 제동등 처리
# ============================================================

def process_taillights(
    frame,
    car_box
):

    x1, y1, x2, y2 = car_box

    cv2.rectangle(
        frame,
        (
            int(x1),
            int(y1)
        ),
        (
            int(x2),
            int(y2)
        ),
        (255, 0, 0),
        1
    )

    (
        highmount_region,
        taillight_region
    ) = get_search_regions(
        (
            x1,
            y1,
            x2,
            y2
        )
    )

    hx1, hy1, hx2, hy2 = [
        int(v)
        for v in highmount_region
    ]

    cv2.rectangle(
        frame,
        (
            hx1,
            hy1
        ),
        (
            hx2,
            hy2
        ),
        (0, 200, 200),
        1
    )

    tx1, ty1, tx2, ty2 = [
        int(v)
        for v in taillight_region
    ]

    cv2.rectangle(
        frame,
        (
            tx1,
            ty1
        ),
        (
            tx2,
            ty2
        ),
        (200, 200, 0),
        1
    )

    highmount_blobs = find_red_blobs(
        frame,
        highmount_region,
        max_blobs=1
    )

    taillight_blobs = find_red_blobs(
        frame,
        taillight_region,
        max_blobs=2
    )

    all_blobs = (
        highmount_blobs
        +
        taillight_blobs
    )

    brightness_values = []

    for (
        bx1,
        by1,
        bx2,
        by2
    ) in all_blobs:

        cv2.rectangle(
            frame,
            (
                bx1,
                by1
            ),
            (
                bx2,
                by2
            ),
            (0, 255, 0),
            2
        )

        brightness = get_red_brightness(
            frame,
            (
                bx1,
                by1,
                bx2,
                by2
            )
        )

        if brightness is not None:

            brightness_values.append(
                brightness
            )

    if brightness_values:

        return (
            float(
                np.mean(
                    brightness_values
                )
            ),
            len(all_blobs)
        )

    return (
        None,
        0
    )


# ============================================================
# 차량 후보 필터
# ============================================================

def is_valid_car_candidate(
    candidate,
    previous_box,
    frame_shape
):

    if previous_box is None:

        return True

    x1, y1, x2, y2 = candidate

    px1, py1, px2, py2 = previous_box

    current_cx = (
        x1 + x2
    ) / 2.0

    current_cy = (
        y1 + y2
    ) / 2.0

    previous_cx = (
        px1 + px2
    ) / 2.0

    previous_cy = (
        py1 + py2
    ) / 2.0

    frame_w = frame_shape[1]

    frame_h = frame_shape[0]

    center_distance = np.sqrt(
        (
            current_cx
            -
            previous_cx
        )
        ** 2
        +
        (
            current_cy
            -
            previous_cy
        )
        ** 2
    )

    max_center_jump = (
        frame_w
        *
        MAX_CENTER_JUMP_RATIO
    )

    if center_distance > max_center_jump:

        return False

    previous_area = (
        px2 - px1
    ) * (
        py2 - py1
    )

    current_area = (
        x2 - x1
    ) * (
        y2 - y1
    )

    if previous_area <= 0:

        return False

    size_ratio = (
        current_area
        /
        previous_area
    )

    if size_ratio > (
        1.0
        +
        MAX_SIZE_CHANGE_RATIO
    ):

        return False

    if size_ratio < (
        1.0
        -
        MAX_SIZE_CHANGE_RATIO
    ):

        return False

    return True


# ============================================================
# 차량 박스 EMA
# ============================================================

def smooth_car_box(
    new_box,
    previous_box
):

    if previous_box is None:

        return new_box

    smoothed = []

    for new_value, old_value in zip(
        new_box,
        previous_box
    ):

        value = (
            CAR_EMA_ALPHA
            *
            new_value
            +
            (
                1.0
                -
                CAR_EMA_ALPHA
            )
            *
            old_value
        )

        smoothed.append(
            value
        )

    return tuple(
        smoothed
    )


# ============================================================
# 메인
# ============================================================

def main():

    global filtered_car_box
    global missed_car_frames

    cap = cv2.VideoCapture(
        0
    )

    if not cap.isOpened():

        print(
            "카메라를 열 수 없습니다."
        )

        return

    # ========================================================
    # STM32 연결
    # ========================================================

    try:

        stm32_ser = serial.Serial(
            STM32_PORT,
            STM32_BAUD,
            timeout=1
        )

        reader_thread = threading.Thread(
            target=stm32_serial_reader,
            args=(stm32_ser,),
            daemon=True
        )

        reader_thread.start()

        print(
            f"[STM32] 시리얼 연결 성공: "
            f"{STM32_PORT} @ "
            f"{STM32_BAUD}bps"
        )

    except Exception as e:

        stm32_ser = None

        print(
            "[STM32] 시리얼 연결 실패 "
            f"(레이더 없이 영상처리): {e}"
        )

    # ========================================================
    # 밝기 변수
    # ========================================================

    history = deque(
        maxlen=SMOOTHING_FRAMES
    )

    baseline = None

    last_brightness = None

    frame_count = 0

    last_yolo_time = 0.0

    brake_missing_count = 0

    brake_light_on_count = 0

    print(
        "Ctrl+C로 종료"
    )

    print(
        "5프레임마다 latest_frame.jpg 저장"
    )

    print(
        "30프레임째 자동 베이스라인 설정"
    )

    print(
        f"YOLO는 {YOLO_INTERVAL}프레임마다 실행"
    )

    try:

        while True:

            ok, frame = cap.read()

            if not ok:

                print(
                    "프레임을 읽을 수 없습니다."
                )

                break

            frame = cv2.resize(
                frame,
                (
                    640,
                    480
                )
            )

            frame_count += 1

            # =================================================
            # YOLO 실행 여부
            # =================================================

            run_yolo_this_frame = (
                (
                    frame_count
                    %
                    YOLO_INTERVAL
                )
                ==
                1
            ) or (
                filtered_car_box is None
            )

            car_found = False

            # =================================================
            # YOLO
            # =================================================

            if run_yolo_this_frame:

                t0 = time.time()

                results = model(
                    frame,
                    classes=[2],
                    verbose=False,
                    imgsz=YOLO_IMGSZ
                )

                last_yolo_time = (
                    time.time()
                    -
                    t0
                )

                boxes = results[0].boxes

                candidates = []

                if len(boxes) > 0:

                    for box in boxes:

                        bx1, by1, bx2, by2 = (
                            box.xyxy[0].tolist()
                        )

                        box_area = (
                            bx2 - bx1
                        ) * (
                            by2 - by1
                        )

                        frame_area = (
                            frame.shape[0]
                            *
                            frame.shape[1]
                        )

                        if box_area < (
                            frame_area
                            *
                            MIN_CAR_AREA_RATIO
                        ):

                            continue

                        candidate = (
                            bx1,
                            by1,
                            bx2,
                            by2
                        )

                        if is_valid_car_candidate(
                            candidate,
                            filtered_car_box,
                            frame.shape
                        ):

                            candidates.append(
                                candidate
                            )

                # =================================================
                # 후보 선택
                # =================================================

                if candidates:

                    # 기존 방식과 동일하게
                    # 후보 중 가장 큰 차량 선택
                    best_candidate = max(
                        candidates,
                        key=lambda b:
                        (
                            b[2] - b[0]
                        )
                        *
                        (
                            b[3] - b[1]
                        )
                    )

                    filtered_car_box = (
                        smooth_car_box(
                            best_candidate,
                            filtered_car_box
                        )
                    )

                    missed_car_frames = 0

                else:

                    missed_car_frames += 1

                    if (
                        missed_car_frames
                        >
                        MAX_MISSED_FRAMES
                    ):

                        filtered_car_box = None

            # =================================================
            # 차량 처리
            # =================================================

            if filtered_car_box is not None:

                (
                    brightness,
                    blob_count
                ) = process_taillights(
                    frame,
                    filtered_car_box
                )

                if brightness is not None:

                    last_brightness = (
                        brightness
                    )

                    history.append(
                        brightness
                    )

                    smoothed = float(
                        np.mean(history)
                    )

                    x1, y1, x2, y2 = (
                        filtered_car_box
                    )

                    delta = None

                    # =========================================
                    # Baseline 이후
                    # =========================================

                    if baseline is not None:

                        delta = (
                            smoothed
                            -
                            baseline
                        )

                        brake_light_on = (
                            delta
                            >
                            DELTA_THRESHOLD
                        )

                        if brake_light_on:

                            brake_light_on_count += 1

                            brake_missing_count = 0

                        else:

                            brake_missing_count += 1

                            brake_light_on_count = 0

                        status = (
                            "BRAKE ON"
                            if brake_light_on
                            else "BRAKE OFF"
                        )

                        cv2.putText(
                            frame,
                            (
                                f"delta="
                                f"{delta:.1f} "
                                f"{status}"
                            ),
                            (
                                int(x1),
                                max(
                                    0,
                                    int(y1) - 10
                                )
                            ),
                            cv2.FONT_HERSHEY_SIMPLEX,
                            0.5,
                            (0, 0, 255),
                            2
                        )

                        # =====================================
                        # STM32 밝기 데이터 전송
                        # =====================================

                        if stm32_ser is not None:

                            try:

                                anomaly_flag = (
                                    1
                                    if brake_light_on
                                    else 0
                                )

                                msg = (
                                    f"B,"
                                    f"{delta:.1f},"
                                    f"{anomaly_flag}"
                                    "\r\n"
                                )

                                stm32_ser.write(
                                    msg.encode(
                                        "utf-8"
                                    )
                                )

                            except Exception as e:

                                print(
                                    "[STM32] "
                                    f"전송 에러: {e}"
                                )

                    # =========================================
                    # 밝기 표시
                    # =========================================

                    cv2.putText(
                        frame,
                        (
                            f"R={smoothed:.1f} "
                            f"(blobs={blob_count})"
                        ),
                        (
                            int(x1),
                            int(y2) + 20
                        ),
                        cv2.FONT_HERSHEY_SIMPLEX,
                        0.5,
                        (255, 255, 0),
                        2
                    )

                    car_found = True

            # =================================================
            # 차량 미검출
            # =================================================

            if not car_found:

                cv2.putText(
                    frame,
                    "차량 인식 대기 중...",
                    (
                        10,
                        30
                    ),
                    cv2.FONT_HERSHEY_SIMPLEX,
                    0.6,
                    (0, 0, 255),
                    2
                )

            # =================================================
            # Baseline
            # =================================================

            if (
                frame_count
                ==
                BASELINE_AT_FRAME
            ):

                if last_brightness is not None:

                    baseline = (
                        last_brightness
                    )

                    print(
                        "[자동] "
                        f"베이스라인 설정: "
                        f"{baseline:.1f}"
                    )

            # =================================================
            # 레이더 필터
            # =================================================

            with serial_data_lock:

                raw_distance = (
                    latest_radar_distance
                )

                raw_speed = (
                    latest_radar_speed
                )

            (
                radar_distance,
                radar_speed
            ) = update_radar_filter(
                raw_distance,
                raw_speed
            )

            # =================================================
            # 레이더 화면 표시
            # =================================================

            if radar_distance is not None:

                radar_text = (
                    f"Radar D="
                    f"{radar_distance:.1f}m"
                )

                if radar_speed is not None:

                    radar_text += (
                        f" "
                        f"V={radar_speed:.1f}"
                    )

                cv2.putText(
                    frame,
                    radar_text,
                    (
                        10,
                        60
                    ),
                    cv2.FONT_HERSHEY_SIMPLEX,
                    0.6,
                    (255, 255, 0),
                    2
                )

            # =================================================
            # WARNING
            # =================================================

            warning = False

            if (
                radar_distance is not None
                and
                radar_speed is not None
                and
                baseline is not None
            ):

                # ------------------------------------------------
                # 상대속도 부호가 음수라면
                # 음수 = 접근하는 상황으로 가정
                # ------------------------------------------------

                approaching = (
                    radar_speed
                    <
                    -WARNING_APPROACH_SPEED
                )

                distance_close = (
                    radar_distance
                    <
                    WARNING_DISTANCE
                )

                brake_missing = (
                    brake_missing_count
                    >=
                    WARNING_BRAKE_MISSING_FRAMES
                )

                if (
                    approaching
                    and
                    distance_close
                    and
                    brake_missing
                ):

                    warning = True

            # =================================================
            # WARNING 표시
            # =================================================

            if warning:

                cv2.rectangle(
                    frame,
                    (
                        0,
                        0
                    ),
                    (
                        frame.shape[1] - 1,
                        frame.shape[0] - 1
                    ),
                    (0, 0, 255),
                    5
                )

                cv2.putText(
                    frame,
                    "!!! WARNING !!!",
                    (
                        150,
                        100
                    ),
                    cv2.FONT_HERSHEY_SIMPLEX,
                    1.2,
                    (0, 0, 255),
                    3
                )

                if stm32_ser is not None:

                    try:

                        warning_msg = (
                            "W,1\r\n"
                        )

                        stm32_ser.write(
                            warning_msg.encode(
                                "utf-8"
                            )
                        )

                    except Exception as e:

                        print(
                            "[STM32] "
                            f"WARNING 전송 에러: {e}"
                        )

            # =================================================
            # 로그
            # =================================================

            if (
                frame_count
                %
                SAVE_EVERY_N_FRAMES
                ==
                0
            ):

                cv2.imwrite(
                    "latest_frame.jpg",
                    frame
                )

                yolo_info = ""

                if run_yolo_this_frame:

                    yolo_info = (
                        f", "
                        f"yolo="
                        f"{last_yolo_time * 1000:.0f}ms"
                    )

                radar_info = ""

                if radar_distance is not None:

                    radar_info = (
                        f", "
                        f"radar="
                        f"D{radar_distance:.1f}"
                    )

                    if radar_speed is not None:

                        radar_info += (
                            f"/S"
                            f"{radar_speed:.1f}"
                        )

                if last_brightness is not None:

                    delta_str = ""

                    if baseline is not None:

                        d = (
                            last_brightness
                            -
                            baseline
                        )

                        delta_str = (
                            f", "
                            f"delta={d:.1f}"
                        )

                    print(
                        f"frame={frame_count}, "
                        f"brightness="
                        f"{last_brightness:.1f}"
                        f"{delta_str}"
                        f"{yolo_info}"
                        f"{radar_info}"
                        f", warning="
                        f"{warning}"
                    )

                else:

                    print(
                        f"frame={frame_count}, "
                        f"차량 미검출"
                        f"{yolo_info}"
                        f"{radar_info}"
                    )

    except KeyboardInterrupt:

        print(
            "\n종료합니다."
        )

    finally:

        cap.release()

        if stm32_ser is not None:

            try:

                stm32_ser.close()

            except Exception:

                pass


# ============================================================
# 실행
# ============================================================

if __name__ == "__main__":

    main()
